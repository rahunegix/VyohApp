NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom auth (JWT + SMS OTP — no Supabase Auth)
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# 24x7SMS — https://www.24x7sms.com/downloads/24X7SMS_http_API2.0.pdf
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=InfoTheme
SMS_SERVICE_NAME=TEMPLATE_BASE
SMS_DLT_TEMPLATE_ID=your_dlt_template_id

# PhonePe payments
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# ─── OpenAI (server-side only — NEVER use NEXT_PUBLIC_) ───
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=dall-e-3

# Admin login (email + password at /admin/login)
# Create admin: node scripts/create-admin.mjs admin@saathini.com YourPassword123
